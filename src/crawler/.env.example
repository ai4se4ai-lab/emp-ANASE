# =============================================================================
# API Credentials for Analogical Reasoning Data Collector
# =============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!
# =============================================================================

# Stack Overflow / Stack Exchange API (optional but recommended)
# Get key at: https://stackapps.com/apps/oauth/register
STACKOVERFLOW_API_KEY=your_stackapps_key_here

# Reddit API (REQUIRED for Reddit collection)
# Create app at: https://www.reddit.com/prefs/apps
# App type must be "script"
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# GitHub Personal Access Token (REQUIRED for GitHub collection)
# Create at: https://github.com/settings/tokens
# Required scopes: repo, read:discussion
GITHUB_TOKEN=ghp_your_github_token_here

# Hugging Face token (optional, recommended for higher API limits)
# Create at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your_huggingface_token_here

# Discord Bot Token (ONLY if you have server owner permission)
# Create at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token

# =============================================================================
# Batch A — New sources
# =============================================================================

# DEV Community / dev.to (OPTIONAL — no key gives ~10 req/min)
# Create at: https://dev.to/settings/extensions (scroll to "DEV API Keys")
DEVTO_API_KEY=your_devto_api_key_here

# Hashnode — no authentication required for public GraphQL API
# (leave blank / do not set)

# =============================================================================
# Batch B — New sources
# =============================================================================

# Hacker News — no authentication required (Algolia HN Search API is public)
# (leave blank / do not set)

# Lobsters — no authentication required (official JSON feed is public)
# (leave blank / do not set)

# =============================================================================
# Batch C — New sources
# =============================================================================

# GitLab Personal Access Token (OPTIONAL — without token: 60 req/hr)
# Create at: https://gitlab.com/-/user_settings/personal_access_tokens
# Required scope: read_api (read-only access to public project data)
GITLAB_TOKEN=glpat_your_gitlab_token_here

# =============================================================================
# LLM second-pass verifier — only fill in the key for your active provider
# =============================================================================

# OpenAI cloud (provider: openai)
# Create at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here

# Anthropic Claude cloud (provider: anthropic)
# Create at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Local OpenAI-compatible server e.g. vLLM / llama.cpp with --api-key
# (provider: openai_compatible) — leave blank if server needs no key
LOCAL_LLM_API_KEY=

# Ollama / LM Studio (provider: ollama | lmstudio) — no key required
# Just start the server and set the base_url in config.yaml -> llm_verifier.providers