# =============================================================================
# API Credentials for Analogical Reasoning Data Collector
# =============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!
# =============================================================================

# Stack Overflow / Stack Exchange API (optional but recommended)
# Get key at: https://stackapps.com/apps/oauth/register
STACKOVERFLOW_API_KEY=your_stackapps_key_here

# Reddit API (REQUIRED for Reddit collection)
# Create app at: https://www.reddit.com/prefs/apps
# App type must be "script"
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# GitHub Personal Access Token (REQUIRED for GitHub collection)
# Create at: https://github.com/settings/tokens
# Required scopes: repo, read:discussion
GITHUB_TOKEN=ghp_your_github_token_here

# Hugging Face token (optional, recommended for higher API limits)
# Create at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your_huggingface_token_here

# Discord Bot Token (ONLY if you have server owner permission)
# Create at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token